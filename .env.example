# Скопируй этот файл в .env и впиши свои ключи. Файл .env никому не показывай.

# --- Amazon Polly (озвучка) ---
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
POLLY_VOICE=Matthew
POLLY_ENGINE=neural

# --- Стоки ---
PEXELS_API_KEY=your_pexels_key_here
PIXABAY_API_KEY=your_pixabay_key_here

# --- Whisper (субтитры) ---
WHISPER_MODEL=base.en

# --- Озвучка по умолчанию для CLI (pipeline.py) ---
# TTS_PROVIDER=edge — бесплатный Edge TTS без ключей, polly — Amazon Polly
TTS_PROVIDER=polly
EDGE_VOICE=en-US-GuyNeural

# --- Фоновая музыка (папка с лицензионными треками, необязательно) ---
# MUSIC_DIR=C:\Users\you\Music\background

# --- Gemini (тексты: черновик сценария, сцены, умные запросы, SEO;
#     запасной вариант для картинок, если Agnes не сработал) ---
GEMINI_API_KEY=your_gemini_key_here
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Agnes AI (картинки type: gen и в раскадровке;
#     запасной вариант для текстов, если Gemini не сработал) ---
AGNES_API_KEY=your_agnes_key_here
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-2.0-flash
# AGNES_IMAGE_MODEL=   # пусто = автоопределение из списка моделей хаба

# --- VeoNonStop (видео Veo + картинки Banana) ---
VEO_API_KEY=your_veo_key_here
# VEO_BASE_URL=https://veononstop.org/api/v1
# Сколько задач вести одновременно. Приложение не превысит лимит аккаунта.
# 2 — проверено замером: на 4 потоках VeoNonStop отдаёт RATE_LIMIT и
# кадры теряются (2 успешных из 8), на 2 — 8 из 8 без единого отказа.
VEO_WORKERS=2
# 0 — быстрый черновик в 720p; 1 — пробовать апскейл до 1080p для финала.
VEO_UPSCALE=0
# Быстрый монтаж: Veo используется только для ключевых сцен, остальные
# AI-фото оживляются локальным Ken Burns без ожидания API.
VEO_FAST_MODE=1
VEO_VIDEO_RATIO=0.25
VEO_ANIMATE_PHOTOS=0

# Локальная модель для черновиков промптов. ВЫКЛЮЧЕНА намеренно: замер
# показал, что qwen2.5:1.5b ПЕРЕВОДИТ текст вместо описания кадра
# («The question of why someone disappears» вместо «person walking away
# confused») и при этом в 5 раз медленнее Gemini. Включать только если
# найдёшь модель, которая реально справляется с задачей.
LOCAL_PROMPT_MODE=0
LOCAL_PROMPT_MODEL=qwen2.5:1.5b

# Аппаратное кодирование видеокартой (NVENC/QSV/AMF) на промежуточных
# файлах рендера. Проверяется реальным пробным кодированием: если
# железо не тянет — молча используется процессор. Финальный проход
# всегда идёт через libx264, он даёт лучшее качество при том же
# размере. Поставь 0, чтобы выключить принудительно.
HW_ENCODE=1
