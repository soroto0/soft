# Скопируй этот файл в .env и впиши свои ключи. Файл .env никому не показывай.
#
# ═══ ЧТО НУЖНО ДЛЯ ПЕРВОГО РОЛИКА ═══
# Ключей здесь много, но обязательных всего ДВА, и оба БЕСПЛАТНЫЕ:
#
#   GEMINI_API_KEY   тексты и картинки   https://aistudio.google.com/apikey
#   PEXELS_API_KEY   видеоряд            https://www.pexels.com/api/
#
# Озвучка работает вообще без ключей (Edge TTS, см. TTS_PROVIDER ниже).
# Всё остальное в этом файле — необязательное: подключается когда угодно и на
# первый ролик не влияет. Платных сервисов среди обязательных НЕТ.
#
# Проще не трогать этот файл вовсе: запусти программу — она сама спросит эти
# два ключа в окне «С чего начать» и проверит их на месте.

# --- Amazon Polly (озвучка) — НЕОБЯЗАТЕЛЬНО ---
# Нужен только если хочешь голоса Polly вместо бесплатного Edge TTS.
# Требует аккаунт AWS с картой. Для первого ролика не нужен.
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
POLLY_VOICE=Matthew
POLLY_ENGINE=neural

# --- Стоки ---
PEXELS_API_KEY=your_pexels_key_here
PIXABAY_API_KEY=your_pixabay_key_here

# --- Фоновая музыка Jamendo (кнопка подбора музыки) ---
# Без него подбор музыки просто пропускается: ролик соберётся молча.
# Ключ типа Client ID: https://devportal.jamendo.com
JAMENDO_CLIENT_ID=your_jamendo_client_id_here

# --- YouTube Data API (разбор ниши перед роликом, yt_research.py) ---
# Нужен обычный ключ типа «API key», OAuth и аудит не требуются:
# https://console.cloud.google.com/apis/credentials
# Без него тему ролика придётся задавать вручную, без опоры на свежие данные.
YOUTUBE_API_KEY=your_youtube_key_here

# --- Whisper (субтитры) ---
WHISPER_MODEL=base.en
# На чём считать: cpu (по умолчанию, работает везде) или cuda — видеокартой
# NVIDIA. cuda быстрее в разы, но требует установленных CUDA-библиотек; если
# их нет, распознавание падает, а не переключается обратно. Ставь только
# после проверки на настоящем прогоне.
# WHISPER_DEVICE=cpu

# --- Озвучка по умолчанию для CLI (pipeline.py) ---
# edge — бесплатный Edge TTS БЕЗ КЛЮЧЕЙ, polly — Amazon Polly (нужен аккаунт
# AWS с привязанной картой). По умолчанию стоит edge: требовать карту раньше
# первого ролика — верный способ потерять человека на пороге. Голоса Polly
# качественнее, переключайся на них, когда захочешь.
TTS_PROVIDER=edge
EDGE_VOICE=en-US-GuyNeural

# --- Фоновая музыка (папка с лицензионными треками, необязательно) ---
# MUSIC_DIR=C:\Users\you\Music\background

# --- Gemini (тексты: черновик сценария, сцены, умные запросы, SEO;
#     запасной вариант для картинок, если Agnes не сработал) ---
GEMINI_API_KEY=your_gemini_key_here
# Квота Gemini считается на пару «проект + модель», а не на ключ, и на
# бесплатном тарифе кончается быстро. Код умеет перебирать несколько
# ключей при ответе 429: просто допиши GEMINI_API_KEY2, GEMINI_API_KEY3
# и так далее — нумерация без пропусков не требуется, берутся все.
# Так же устроены VEO_API_KEY2... и AGNES_API_KEY2...
# GEMINI_API_KEY2=
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Agnes AI (картинки type: gen и в раскадровке;
#     запасной вариант для текстов, если Gemini не сработал) ---
AGNES_API_KEY=your_agnes_key_here
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-2.0-flash
# AGNES_IMAGE_MODEL=   # пусто = автоопределение из списка моделей хаба

# --- VeoNonStop (видео Veo + картинки Banana) ---
VEO_API_KEY=your_veo_key_here
# VEO_BASE_URL=https://veononstop.org/api/v1
# Сколько задач вести одновременно. Приложение не превысит лимит аккаунта.
# 2 — проверено замером: на 4 потоках VeoNonStop отдаёт RATE_LIMIT и
# кадры теряются (2 успешных из 8), на 2 — 8 из 8 без единого отказа.
VEO_WORKERS=2
# 0 — быстрый черновик в 720p; 1 — пробовать апскейл до 1080p для финала.
VEO_UPSCALE=0
# Быстрый монтаж: Veo используется только для ключевых сцен, остальные
# AI-фото оживляются локальным Ken Burns без ожидания API.
VEO_FAST_MODE=1
VEO_VIDEO_RATIO=0.25
VEO_ANIMATE_PHOTOS=0

# --- Суточный лимит КАРТИНОК у VeoNonStop (с 2026-08-05) ---
# Сервис ограничил число картинок в сутки по тарифу (4 потока — 500,
# 12 — 1500, 24 — 3000) и предупредил, что числа не окончательные. Поэтому
# САМ ЛИМИТ НЕ ЗАДАЁТСЯ ЗДЕСЬ — он читается у сервиса (GET /account/usage,
# поле image_remaining). Ниже только политика: кому картинки достаются
# первыми, когда их мало. На ВИДЕО лимит не распространяется — сервис
# ответил «только картинки», и трогать генерацию видео этими ключами нельзя.
#
# Сколько картинок беречь под обложки текущего ролика: без обложки ролик не
# выложить, а кадр заменяется стоком. Кадры и перегенерация в этот резерв
# не лезут.
# VEO_IMAGE_COVER_RESERVE=3
# Ниже этого остатка выключается косметическая перегенерация неудачных
# кадров (refix_storyboard) — это то, без чего ролик прекрасно выходит.
# VEO_IMAGE_POLISH_FLOOR=25
# Как часто перечитывать остаток у сервиса, секунды. Чаще не нужно:
# поддержка отдельно просила не долбить сервер запросами.
# VEO_QUOTA_TTL_S=120
# Сколько картинок закладывать на один ролик при планировании ночи
# (обложки). При VEO_VIDEO_RATIO<1 к ним добавляются планы-фото.
# AUTOPILOT_IMAGES_PER_VIDEO=3

# Локальная модель для черновиков промптов. ВЫКЛЮЧЕНА намеренно: замер
# показал, что qwen2.5:1.5b ПЕРЕВОДИТ текст вместо описания кадра
# («The question of why someone disappears» вместо «person walking away
# confused») и при этом в 5 раз медленнее Gemini. Включать только если
# найдёшь модель, которая реально справляется с задачей.
LOCAL_PROMPT_MODE=0
LOCAL_PROMPT_MODEL=qwen2.5:1.5b

# Аппаратное кодирование видеокартой (NVENC/QSV/AMF) на промежуточных
# файлах рендера. Проверяется реальным пробным кодированием: если
# железо не тянет — молча используется процессор. Финальный проход
# всегда идёт через libx264, он даёт лучшее качество при том же
# размере. Поставь 0, чтобы выключить принудительно.
HW_ENCODE=1
