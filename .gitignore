# Секреты — никогда не коммитить.
# Это правило НЕ отменяется приватностью репозитория: история git вечна,
# копии расходятся по клонам и бэкапам, а при утечке аккаунта уходит всё
# сразу. Ключи живут только здесь и в .env.
.env
.env.bak
.env.*.bak
settings.json
.secrets/
client_secret*.json
token_*.json

# Результаты работы пайплайна
output/
project*/
project*.zip

# Папки проектов КАНАЛОВ (channels.projects_dir): там готовые ролики по
# сотням мегабайт, озвучка и раскадровка — не место в репозитории.
# Имена берутся из id канала в channels.json.
abyss/
home-vault/
estoico-es/
einsturzpunkt/
# einsturzpunkt завёлся 09.08, когда список уже был написан, и три недели
# висел НЕЗАКРЫТЫМ: замер 11.08 — 18496 файлов, 15.2 ГБ готового видео в
# состоянии «неотслежено». Один git add -A клал это в ПУБЛИЧНУЮ историю
# навсегда — из истории такое не вырезать, только переписывать репозиторий.
# Заводишь канал — впиши его СЮДА в тот же час, иначе защита молчит именно
# про тот канал, который сейчас снимают.
проба_es/
проба_минута/
_проверка_обложек/
brand/
# Пробные каналы — такие же папки проектов, только с русскими именами, и они
# точно так же набирают вес: замер 11.08 — проба_es 78.6 МБ. brand/ это
# исходники логотипов и шапок каналов вместе с разбором ниши и конкурентов
# (brand/einsturzpunkt/КАНАЛ.md) — деловые сведения, не код.

# Локальные настройки Claude Code
.claude/settings.local.json
# Рабочие копии агентов: это полные клоны проекта со своими правками.
# Секретов в них нет (проверено), но `git add -A` втянул бы дубль всего
# дерева — и вместе с ним то, что в самой копии ещё не заигнорено.
.claude/worktrees/
.claude/tasks/

# Кэши инструментов и редактора
.ruff_cache/
.vscode/

# Готовая раздаваемая копия (setup\dist_pack.ps1). Собирается из
# исходников когда нужно, в репозитории ей делать нечего.
/dist/
kontent-fabrika/
kontent-fabrika.zip

# Логи приложения
app.log
app.log.old

# Журнал провалов генерации вариантов: локальная статистика этой машины
# (какой тип сколько раз не собрался и до когда он в паузе). Секретов нет,
# но и общего смысла тоже — на другой машине история своя.
variant_failures.json

# Временные копии src/ для tsc-проверки сгенерированного кода. Живут внутри
# remotion/ (иначе tsc не найдёт node_modules) и существуют только во время
# генерации — но при `git add -A` в этот момент утекли бы в репозиторий.
remotion/tmp*/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Remotion: сборка и временные картинки для popup
remotion/build/
remotion/public/ovl_*
remotion/node_modules/

# Синтезированные SFX — генерируются кодом при первом обращении (render.py)
assets/sfx/*.wav

# HyperFrames: рендер/кэш (нет локального node_modules — всё через npx --yes)
hyperframes/renders/
hyperframes/.hyperframes/
hyperframes/hf_*

# Случайные папки-проекты в корне
/2/

# Числовые папки-проекты в корне
/[0-9]*/

# Библиотека фоновой музыки (свои/Jamendo треки — бинарные файлы)
/music_library/

# Тестовые проекты (рендеры для проверки, не исходники)
/test_*/

# Временные props-файлы Remotion (мусор от рендера/дым-тестов)
tmp*_props.json

# временные папки генератора вариантов в корне
tmp*/
variants_run.log

# Кэш разбора ниши (пересобирается сам на каждый ролик)
/.niche_cache/

# Сводка ночного автопилота — про конкретную ночь, не про код
/autopilot_report.txt

# Библиотека звуковых эффектов — бинарники и, судя по именам, лицензионные.
# Репозиторий публичный: медиа в него не кладём.
/assets/

# Черновик письма в поддержку: внутри номер аккаунта и префикс ключа,
# а репозиторий публичный.
veononstop_support.txt

# Копия истории использованных стоков, которую софт делает при её порче.
# Это диагностика конкретной машины, а не код.
used_media.json.broken
used_media.json

# Оценка расхода суточного лимита картинок. Счётчик КОНКРЕТНОЙ машины и
# конкретного аккаунта (внутри — хеши ключей), к коду отношения не имеет.
.veo_image_usage.json
.veo_image_usage.json.tmp
subs2/

# Выгрузки статистики канала — личные данные, в публичный репозиторий им нельзя
analytics/*.csv
analytics/*.xlsx
analytics/*.zip
analytics/client_secret*.json
analytics/token.json
# Накопленная история каналов (yt_history): названия роликов, просмотры,
# досмотры, поисковые запросы зрителей. Ключей внутри нет — тексты ошибок
# чистятся при записи, — но это цифры конкретных каналов владельца, и в
# публичном репозитории им делать нечего.
analytics/history.json
analytics/history.json.tmp
analytics/history.broken-*.json
# Копии обложек, за которые замерен CTR (yt_history.py ctr). Картинки
# конкретных роликов владельца, к коду отношения не имеют; лежат здесь
# потому, что папка проекта достаётся следующему ролику и оригинал
# затирается — а без картинки замеренный CTR не значит ничего.
analytics/thumbs/

# Архив старых файлов из корней каналов — рабочий мусор, не код
/_архив_из_корней/
analytics/upload_*.json
/_битые_схемы/
/setup/Output/
/dist/

# Метка демо-режима: у купленной копии её нет, у раздачи-демо кладётся руками
demo.json
